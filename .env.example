# ──────────────────────────────────────────────────────────
# FasoBet — Variables d'environnement (Exemple)
# ──────────────────────────────────────────────────────────
# Copier ce fichier vers .env et adapter les valeurs pour votre environnement
# Toutes les variables sont requises sauf indication contraire

# ─── Base de données PostgreSQL ─────────────────────────────
# (Requis pour Django et l'application principale)
POSTGRES_DB=fasobet
POSTGRES_USER=fasobet
POSTGRES_PASSWORD=changeme_in_prod  # CHANGER EN PRODUCTION !

# ─── Configuration Django ──────────────────────────────────
# (Requis pour le backend Django)
DJANGO_SECRET_KEY=django-insecure-change-me-in-production  # CHANGER EN PRODUCTION !
DJANGO_DEBUG=True  # Désactiver en production (False)
DJANGO_DB_HOST=postgres
DJANGO_DB_PORT=5432
DJANGO_DB_NAME=fasobet
DJANGO_DB_USER=fasobet
DJANGO_DB_PASSWORD=changeme_in_prod  # CHANGER EN PRODUCTION !

# ─── Configuration Redis ────────────────────────────────────
# (Requis pour le cache et Celery)
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Upstash Redis (Fallback pour production) ──────────────
# (Optionnel - utilisé comme fallback si Redis local indisponible)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Configuration Next.js ──────────────────────────────────
# (Requis pour le frontend)
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_FASTAPI_URL=http://fastapi:8001
NEXT_PUBLIC_DJANGO_API_URL=http://django:8000/api

# ─── Clés API Externes ──────────────────────────────────────
# (Requis pour les agents IA - obtenir vos clés sur les plateformes respectives)
FOOTBALL_API_KEY=your_api_football_key
ANTHROPIC_API_KEY=your_anthropic_key
PERPLEXITY_API_KEY=your_perplexity_key

# ─── Configuration FastAPI ──────────────────────────────────
# (Requis pour le moteur d'inférence)
FASTAPI_ENV=development  # Valeurs possibles: development, staging, production
FASTAPI_DEBUG=True  # Désactiver en production (False)

# ─── Observabilité (BLOC 5) ──────────────────────────────────
# (Optionnel - pour le monitoring et les traces)
OTEL_SERVICE_NAME=fasobet-fastapi
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=service.name=fasobet-fastapi,deployment.environment=development

# ─── JWT Authentication ──────────────────────────────────────
# (Requis pour l'authentification)
JWT_SECRET=super-secret-jwt-key-change-in-production  # CHANGER EN PRODUCTION !

# ─── CORS Configuration ────────────────────────────────────
# (Optionnel - liste des origines autorisées, séparées par des virgules)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Celery Configuration ───────────────────────────────────
# (Requis pour les tâches asynchrones)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
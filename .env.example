# ──────────────────────────────────────────────────────────
# FasoBet — Variables d'environnement
# ──────────────────────────────────────────────────────────
# Copier ce fichier vers .env :
#   cp .env.example .env
# Adapter TOUTES les valeurs marquées "⚠️ CHANGER ⚠️"

# ─── Base de données PostgreSQL ─────────────────────────────
POSTGRES_DB=fasobet
POSTGRES_USER=fasobet
POSTGRES_PASSWORD=⚠️_CHANGER_⚠️_30+_chars_random

# ─── Django ─────────────────────────────────────────────────
DJANGO_SECRET_KEY=⚠️_CHANGER_⚠️_50+_chars_random
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_DB_HOST=postgres
DJANGO_DB_PORT=5432
DJANGO_DB_NAME=fasobet
DJANGO_DB_USER=fasobet
DJANGO_DB_PASSWORD=⚠️_CHANGER_⚠️_same_as_POSTGRES_PASSWORD

# ─── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── JWT — MUST match between Django and FastAPI ────────────
JWT_SECRET=⚠️_CHANGER_⚠️_same_as_DJANGO_SECRET_KEY
DJANGO_JWT_SECRET=⚠️_CHANGER_⚠️_same_as_JWT_SECRET

# ─── Upstash Redis (fallback production — laisser vide si inutilisé) ─
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Next.js — URLs navigateur (résolues côté client) ──────
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_DJANGO_URL=http://localhost:8001

# ─── Next.js — URLs SSR (résolues côté serveur Docker) ─────
FASTAPI_INTERNAL_URL=http://fastapi:8000
DJANGO_INTERNAL_URL=http://django:8001
FASTOBET_INTERNAL_KEY=fasobet-internal-2025

# ─── FastAPI ────────────────────────────────────────────────
FASTAPI_ENV=production
FASTAPI_DEBUG=False
CORS_ORIGINS=http://localhost:3001,https://app.fasobet.com

# ─── Celery ─────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ─── Clés API Externes (agents IA — optionnel sans agents) ─
FOOTBALL_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# ─── Observabilité OpenTelemetry (optionnel) ────────────────
# Laisser OTEL_EXPORTER_OTLP_ENDPOINT vide pour désactiver
OTEL_SERVICE_NAME=fasobet-fastapi
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=service.name=fasobet-fastapi,deployment.environment=production
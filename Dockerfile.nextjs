# --- Base ---
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat curl
WORKDIR /app

# --- Dépendances ---
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm install --frozen-lockfile

# --- Builder ---
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# On désactive la télémétrie Next.js pendant le build
ENV NEXT_TELEMETRY_DISABLED 1

# Variables d'environnement nécessaires pour le build (NEXT_PUBLIC_* sont inlinés au build)
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_FASTAPI_URL
ARG NEXT_PUBLIC_DJANGO_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_FASTAPI_URL=$NEXT_PUBLIC_FASTAPI_URL
ENV NEXT_PUBLIC_DJANGO_URL=$NEXT_PUBLIC_DJANGO_URL

RUN npm run build

# --- Développement ---
FROM base AS development
ENV NODE_ENV development
COPY --from=deps /app/node_modules ./node_modules
COPY . .
EXPOSE 3001
ENV PORT 3001
ENV HOSTNAME "0.0.0.0"
CMD ["npm", "run", "dev"]

# --- Runner (Production) ---
FROM base AS runner
WORKDIR /app
ENV NODE_ENV production
ENV NEXT_TELEMETRY_DISABLED 1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copie des assets nécessaires uniquement
COPY --from=builder /app/public ./public
# Copie du build standalone optimisé
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3001
ENV PORT 3001
ENV HOSTNAME "0.0.0.0"

# server.js est généré par le mode standalone
CMD ["node", "server.js"]

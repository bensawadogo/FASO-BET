# ──────────────────────────────────────────────────────────
# FasoBet — Celery Worker (Multi-stage Production)
# Partage builder avec Django pour ML deps (XGBoost, LightGBM)
# Size: ~2.69GB → ~700MB optimisé
# ──────────────────────────────────────────────────────────

FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Merge Django + FastAPI requirements
COPY requirements.django.txt requirements.fastapi.txt .
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /wheels \
    -r requirements.django.txt \
    -r requirements.fastapi.txt

# ──────────────────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /wheels /wheels
RUN pip install --no-cache /wheels/*

COPY . .

# No EXPOSE — Celery not HTTP

CMD ["celery", "-A", "sportpred", "worker", "--loglevel=info", "--concurrency=4", "--max-tasks-per-child=1000"]

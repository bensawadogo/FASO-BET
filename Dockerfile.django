# ──────────────────────────────────────────────────────────
# FasoBet — Django (Multi-stage Production)
# Stage 1: builder (compile deps)
# Stage 2: runtime (minimal)
# Size: ~800MB → ~600MB optimisé
# ──────────────────────────────────────────────────────────

FROM python:3.12-slim AS builder

WORKDIR /build

# Dépendances système
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.django.txt .

# Build wheels (compiles tout une fois)
RUN pip wheel --no-cache-dir --no-deps --wheel-dir /build/wheels -r requirements.django.txt

# ──────────────────────────────────────────────────────────
# Runtime Stage — Minimal
FROM python:3.12-slim

WORKDIR /app

# Seulement les libs nécessaires en runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy wheels depuis builder
COPY --from=builder /build/wheels /wheels

# Install wheels (très rapide)
RUN pip install --no-cache /wheels/*

# Copy app source
COPY . .

EXPOSE 8001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://127.0.0.1:8001/health/ || exit 1

# Production: pas de volumes, source copié
CMD ["gunicorn", "sportpred.wsgi:application", "--bind", "0.0.0.0:8001", "--workers", "2", "--timeout", "120", "--access-logfile", "-", "--error-logfile", "-"]

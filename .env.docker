# Variables d'environnement pour Django
POSTGRES_DB=fasobet
POSTGRES_USER=fasobet
POSTGRES_PASSWORD=changeme_prod

# Variables pour Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_JWT_SECRET=your-secret-key-here
JWT_SECRET=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nextjs,fastapi,django,host.docker.internal,.trycloudflare.com

# Variables pour Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Variables pour FastAPI
FASTAPI_REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API Keys for Scraping
# ⚠️ Remplacer par vos propres clés — les valeurs ci-dessous sont des placeholders
FOOTBALL_API_KEY=4a98cabb1419390150a7a3fb46b4095f
FOOTBALL_DATA_API_KEY=c94db105a1b84549bf8e3fe670a6fe91
ODDS_API_KEY=5a9472d47e92a4e6a29ca16729efa4d3
ODDSPAPI_KEY=558f5ee6-4caf-4719-aeac-3b22deff03a9

# Tunnel URL (change à chaque redémarrage de cloudflared)
BACKEND_URL=https://expects-eva-reviewer-happen.trycloudflare.com

# ─── Variables pour Next.js (CLIENT — navigateur) ───────────────────
# Ces URLs sont exécutées DANS le navigateur du client
# En DEV: localhost resolve au PC
# En PROD: doit être le domaine public (ex: https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:8002
NEXT_PUBLIC_FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_DJANGO_URL=http://localhost:8002

# ─── Variables pour Next.js SSR (SERVER — serveur Node.js) ────────
# Ces URLs sont exécutées DANS le conteneur Next.js (réseau Docker)
# Utilisent les noms de service Docker pour la résolution DNS
API_DJANGO_URL=http://django:8001
API_FASTAPI_URL=http://fastapi:8000

# ─── CORS — Déclarer les origines autorisées pour FastAPI ──────────
# Cela va remplir settings.CORS_ORIGINS en FastAPI
# Formats: http://localhost:3001,http://nextjs:3001,https://yourdomain.com
CORS_ORIGINS=http://localhost:3001,http://nextjs:3001,http://127.0.0.1:3001,https://expects-eva-reviewer-happen.trycloudflare.com

# Variables pour CinetPay
CINETPAY_API_KEY=your_cinetpay_api_key_here
CINETPAY_SITE_ID=your_cinetpay_site_id_here
CINETPAY_NOTIFY_URL=https://expects-eva-reviewer-happen.trycloudflare.com/api/payments/callback/
CINETPAY_RETURN_URL=http://localhost:3001/payment/success

# ─── NextAuth.js / Google OAuth ──────────────────────────────
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=dev-secret-change-in-production-abc123xyz789
NEXTAUTH_TO_DJANGO_SECRET=dev-shared-secret-django-bridge-abc123
GOOGLE_CLIENT_ID=PLACEHOLDER_A_CONFIGURER
GOOGLE_CLIENT_SECRET=PLACEHOLDER_A_CONFIGURER

# Sentry (optionnel — laisser vide pour désactiver)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

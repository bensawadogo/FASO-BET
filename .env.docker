# ──────────────────────────────────────────────────────────
# FasoBet — Variables d'environnement (Docker)
# ──────────────────────────────────────────────────────────
# Copier vers .env et adapter les valeurs

# ─── Postgres ────────────────────────────────────────────
POSTGRES_DB=fasobet
POSTGRES_USER=fasobet
POSTGRES_PASSWORD=changeme_in_prod

# ─── Django ──────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-change-me-in-production
DJANGO_DEBUG=True
DJANGO_DB_HOST=postgres
DJANGO_DB_PORT=5432
DJANGO_DB_NAME=fasobet
DJANGO_DB_USER=fasobet
DJANGO_DB_PASSWORD=changeme_in_prod

# ─── Redis ───────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Upstash (fallback production) ───────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Next.js ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_FASTAPI_URL=http://fastapi:8001
NEXT_PUBLIC_DJANGO_API_URL=http://django:8000/api

# ─── API Externes ────────────────────────────────────────
FOOTBALL_API_KEY=
ANTHROPIC_API_KEY=
PERPLEXITY_API_KEY=

# ─── FastAPI ─────────────────────────────────────────────
FASTAPI_ENV=development
FASTAPI_DEBUG=True

# ─── Observabilité (BLOC 5) ──────────────────────────────
OTEL_SERVICE_NAME=fasobet-fastapi
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_METRICS_EXPORTER=otlp
OTEL_TRACES_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_RESOURCE_ATTRIBUTES=service.name=fasobet-fastapi,deployment.environment=development
